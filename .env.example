# Read only by api/ (server side). Never import in src/. Real values go in .env (gitignored) or Vercel env.
# api/parse-sig uses Gemini when GEMINI_API_KEY is set, otherwise Anthropic.
GEMINI_API_KEY=
# Optional: defaults to gemini-3.5-flash-lite. Set if that model name has been retired.
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# api/check (buyer JSON API): comma-separated keys. Empty = endpoint answers 503 (closed).
CHECK_API_KEYS=
